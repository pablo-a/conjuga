# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
*.local

# Generated data and PWA artifacts
# Note: src/data/*.json IS committed — it is source data, not build output.
dev-dist/
public/sw.js
public/workbox-*.js
public/registerSW.js

# Test output
coverage/
.vitest/
test-results/
playwright-report/

# Caches
.cache/
.temp/
.vite/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Sortie de compilations ponctuelles hors du build Vite
dist-test/

# Réglages locaux de l’agent, propres à chaque poste — sauf les permissions
# accordées au dépôt lui-même, qui valent pour quiconque y travaille.
# Le contenu est exclu fichier par fichier (`.claude/*`) et non par le dossier :
# git ne rouvre jamais un répertoire déjà exclu, et la négation serait ignorée.
.claude/*
!.claude/settings.json
